{
	"name": "a8cteam51/a8csp-alt-text-generator",
	"type": "wordpress-plugin",
  
	"description": "Automatically generate alt text for images in your WordPress media library using OpenAI, improving accessibility and SEO.",
	"homepage": "https://specialprojects.automattic.com/",
	"license": "GPL-2.0-or-later",
	"authors": [
	  {
		"name": "Tom Rhodes",
		"homepage": "https://profiles.wordpress.org/tommusrhodus/"
	  },
	  {
		"name": "Automattic Special Projects Team",
		"homepage": "https://specialprojects.automattic.com/"
	  }
	],
  
	"repositories": [
	  {
		"type": "vcs",
		"url": "https://github.com/a8cteam51/team51-configs"
	  },
	  {
		"type": "composer",
		"url": "https://wpackagist.org"
	  }
	],
	"require": {
	  "php": ">=8.3",
	  "ext-json": "*"
	},
	"require-dev": {
	  "a8cteam51/team51-configs": "dev-trunk",
  
	  "wp-cli/i18n-command": "^2",
	  "lucatume/wp-browser": "^4",
  
	  "roave/security-advisories": "dev-latest"
	},
  
	"scripts": {
  
	  "format:php": "phpcbf --standard=./.phpcs.xml --basepath=. ./ -v",
	  "lint:php": [
		"@lint:php:phpcs"
	  ],
	  "lint:php:phpcs": "phpcs --standard=./.phpcs.xml --basepath=. ./ -v",
  
	  "internationalize": [
		"@i18n:makepot",
		"@i18n:updatepo",
		"@i18n:makemo",
		"@i18n:makephp"
	  ],
	  "i18n:makepot": "wp i18n make-pot ./ --slug=a8csp-scaffold",
	  "i18n:updatepo": "wp i18n update-po ./languages/a8csp-scaffold.pot",
	  "i18n:makemo": "wp i18n make-mo ./languages/",
	  "i18n:makephp": "wp i18n make-php ./languages/",
  
	  "packages-install": "@composer install --ignore-platform-reqs --no-interaction",
	  "packages-update": [
		"@composer clear-cache",
		"@composer update --prefer-stable --ignore-platform-reqs --no-interaction"
	  ]
	},
	"config": {
	  "allow-plugins": {
		"composer/*": true,
		"dealerdirect/phpcodesniffer-composer-installer": true,
		"phpstan/extension-installer": true
	  }
	}
  }